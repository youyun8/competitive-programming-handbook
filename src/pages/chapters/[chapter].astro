---
import { getCollection } from 'astro:content';
import { Code } from 'astro:components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import ChapterProblemList from '@/components/problems/ChapterProblemList.astro';
import { chapterWorkshops } from '@/lib/chapter-workshops';
import { chapterExamples } from '@/lib/chapter-examples';
import { chapterExerciseCode } from '@/lib/chapter-exercise-code';
import { chapterExerciseSolutions } from '@/lib/chapter-exercise-solutions';
import { curriculum, sectionSlug } from '@/lib/curriculum';
import { problemEntriesForChapter } from '@/lib/problem-list';
import { withBase } from '@/lib/site';

export function getStaticPaths() {
  return curriculum.chapters.map((chapter) => ({
    params: { chapter: String(chapter.chapter) },
    props: { chapter }
  }));
}

const { chapter } = Astro.props;
const chapterIndex = curriculum.chapters.findIndex((item) => item.chapter === chapter.chapter);
const previousChapter = curriculum.chapters[chapterIndex - 1];
const nextChapter = curriculum.chapters[chapterIndex + 1];
const lessons = await getCollection('lessons');
const exercises = await getCollection('exercises');
const workshop = chapterWorkshops[chapter.chapter]!;
const examples = chapterExamples[chapter.chapter] ?? [];
const problemEntries = problemEntriesForChapter(chapter.chapter);
// 分級習題屬於整章，不屬於任何一節；解答與程式碼跟著習題留在章頁，各只出現一次。
const normalizeTitle = (title: string) => title.replace(/\s+/g, '');
---

<BaseLayout title={`第 ${chapter.chapter} 章 ${chapter.title}`} wide>
  <Breadcrumb
    items={[
      {
        label: chapter.volume === 'upper' ? '上冊' : '下冊',
        href: withBase(`/volumes/${chapter.volume}/`)
      }
    ]}
    current={`第 ${chapter.chapter} 章 ${chapter.title}`}
  />
  <p class="eyebrow">{chapter.volume === 'upper' ? '上冊' : '下冊'} · Chapter {chapter.chapter}</p>
  <h1>{chapter.title}</h1>
  <p class="lede">
    本章共 {chapter.sections.length} 節，每節都有可直接閱讀的核心導讀；其中部分主題另有含完整程式模板與視覺化的深度教學。
  </p>
  <div class="meta">
    <span>書本 {chapter.book_pages[0]}–{chapter.book_pages[1]} 頁</span>
    <span>PDF {chapter.pdf_pages[0]}–{chapter.pdf_pages[1]} 頁</span>
    <span>{exercises.filter((item) => item.data.chapter === chapter.chapter).length} 道已發布練習</span>
  </div>
  <ul class="section-list">
    {
      chapter.sections.map((section) => {
        const lesson = lessons.find((item) => item.data.section === section.id);
        return (
          <li class="section-row">
            <span class="section-id">{section.id}</span>
            <div>
              <h3>
                <a href={withBase(`/lessons/${sectionSlug(section)}/`)}>{section.title}</a>
              </h3>
              <p>{section.topics.join('、')}</p>
            </div>
            <span class="badge verified">{lesson ? '深度教學' : '核心導讀'}</span>
          </li>
        );
      })
    }
  </ul>

  <section aria-labelledby="chapter-overview-title">
    <h2 id="chapter-overview-title">本章深入導讀</h2>
    <p class="lede">{workshop.overview}</p>
    <ul>
      {workshop.connections.map((connection) => <li>{connection}</li>)}
    </ul>
  </section>

  <section aria-labelledby="chapter-examples-title">
    <h2 id="chapter-examples-title">教材經典例題與 C++ 解答</h2>
    <div class="grid">
      {
        examples.map((example) => (
          <article class="card">
            <p class="eyebrow">
              {example.label}
              {example.source ? ` · ${example.source}` : ''}
            </p>
            <h3>{example.title}</h3>
            {example.statement.split('\n').map((line) => (
              <p class="statement-line">{line}</p>
            ))}
            {example.url && (
              <p>
                外部題目連結：
                <a href={example.url} target="_blank" rel="noreferrer noopener">
                  {example.source || example.url}
                </a>
              </p>
            )}
            <h4>解題想法</h4>
            <p>{example.idea}</p>
            <h4>C++17 參考解答</h4>
            <Code code={example.code} lang="cpp" theme="github-dark-default" />
            <p>
              <strong>複雜度：</strong>
              {example.complexity}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="chapter-practice-title">
    <h2 id="chapter-practice-title">章末分級習題</h2>
    <div class="grid">
      {
        workshop.exercises.map((exercise) => {
          const solution = chapterExerciseSolutions[normalizeTitle(exercise.title)];
          const solutionCode = chapterExerciseCode[normalizeTitle(exercise.title)];
          return (
            <article class="card">
              <span class="badge">{exercise.level}</span>
              <h3>{exercise.title}</h3>
              <p>{exercise.prompt}</p>
              <p class="meta">訓練重點：{exercise.focus}</p>
              {solution ? (
                <details>
                  <summary>解法、正確性與 C++17 實作</summary>
                  <h4>演算法</h4>
                  <p>{solution.approach}</p>
                  <h4>正確性</h4>
                  <p>{solution.correctness}</p>
                  <h4>複雜度</h4>
                  <p>{solution.complexity}</p>
                  {solutionCode ? (
                    <Code code={solutionCode} lang="cpp" theme="github-dark-default" />
                  ) : (
                    <p class="content-pending">目前尚未附上程式碼實作。</p>
                  )}
                </details>
              ) : (
                <p>先依「{exercise.focus}」建立不變量，再逐步驗證每次更新不會排除正確答案。</p>
              )}
            </article>
          );
        })
      }
    </div>
  </section>
  <ChapterProblemList entries={problemEntries} />
  <nav class="page-actions" aria-label="前後章節">
    {
      previousChapter ? (
        <a class="button secondary" href={withBase(`/chapters/${previousChapter.chapter}/`)}>
          ← 第 {previousChapter.chapter} 章 {previousChapter.title}
        </a>
      ) : (
        <a class="button secondary" href={withBase(`/volumes/${chapter.volume}/`)}>
          ← {chapter.volume === 'upper' ? '上冊' : '下冊'}總覽
        </a>
      )
    }
    {
      nextChapter ? (
        <a class="button secondary" href={withBase(`/chapters/${nextChapter.chapter}/`)}>
          第 {nextChapter.chapter} 章 {nextChapter.title} →
        </a>
      ) : (
        <a class="button secondary" href={withBase('/appendix/')}>
          附錄 A：C++ 競賽工程技巧 →
        </a>
      )
    }
  </nav>
</BaseLayout>
