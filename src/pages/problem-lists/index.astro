---
import { getCollection } from 'astro:content';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { practiceLink } from '@/lib/navigation';
import { problemListCounts } from '@/lib/problem-list';
import { withBase } from '@/lib/site';
import { strategyProblemCounts } from '@/lib/strategy-problems';
import { strategyTopics } from '@/lib/strategy-topics';

const exercises = await getCollection('exercises', ({ data }) => data.review_status === 'verified');
---

<BaseLayout title="題單索引" description="教材題單與策略題單兩種索引方式，練習進度共用同一份資料。" wide>
  <Breadcrumb current="題單索引" />
  <p class="eyebrow">Problem lists</p>
  <h1>題單索引</h1>
  <p class="lede">
    同一批題目有兩種索引方式：<strong>依教材章節</strong>找進度、<strong>依解題手法</strong>找題型。
    兩份題單只重建索引與外部連結，不轉載題目敘述；本站自己撰寫題解與筆記的題目則收在<a href={practiceLink.href}>題庫</a
    >。三處的練習狀態共用同一份進度資料，在任一處標記都會同步。
  </p>

  <div class="grid">
    <article class="card">
      <p class="eyebrow">依教材章節</p>
      <h2><a href={withBase('/problem-lists/textbook/')}>教材題單</a></h2>
      <p>
        羅勇軍《演算法競賽》配套題單，依十章 {problemListCounts.sections} 個小節編排，可依章節、例題／習題與平臺篩選。
      </p>
      <p class="meta">
        <span>{problemListCounts.rows} 筆條目</span>
        <span>{problemListCounts.unique_problems} 道不重複題目</span>
        <span>例題 {problemListCounts.examples}／習題 {problemListCounts.practice}</span>
      </p>
      <a href={withBase('/problem-lists/textbook/')}>開啟教材題單 →</a>
    </article>

    <article class="card">
      <p class="eyebrow">依解題手法</p>
      <h2><a href={withBase('/problem-lists/strategies/')}>策略題單</a></h2>
      <p>
        <a href={withBase('/strategies/')}>策略圖鑑</a>
        {strategyTopics.length} 個主題的題目總表，可依主題、難度星級、策略標籤與平臺篩選。
      </p>
      <p class="meta">
        <span>{strategyProblemCounts.rows} 筆條目</span>
        <span>{strategyProblemCounts.unique} 道不重複題目</span>
        <span>{strategyProblemCounts.linked} 題附判題連結</span>
      </p>
      <a href={withBase('/problem-lists/strategies/')}>開啟策略題單 →</a>
    </article>

    <article class="card">
      <p class="eyebrow">本站題目卡</p>
      <h2><a href={practiceLink.href}>題庫</a></h2>
      <p>附本站改寫題目、逐層提示、C++17 解答與私人筆記的題目，可依章節、難度與學習狀態篩選。</p>
      <p class="meta">
        <span>{exercises.length} 題已發布</span>
        <span>狀態、解答與思路都保存在本機並可同步</span>
      </p>
      <a href={practiceLink.href}>開啟題庫 →</a>
    </article>
  </div>

  <section class="card" style="margin-top:2rem">
    <h2>怎麼選</h2>
    <ul>
      <li><strong>正在照書推進</strong>：用教材題單，跟著章節小節逐題累積。</li>
      <li><strong>賽前複習或遇到新題型</strong>：用策略題單，依手法與難度挑題。</li>
      <li><strong>想要完整題解與筆記</strong>：用題庫，每題都有提示、解答與可保存的思路。</li>
    </ul>
  </section>
</BaseLayout>
