---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { curriculum } from '@/lib/curriculum';
import { glossaryLink, learnLink, patternsLink, practiceLink, problemListsLink, textbookNav } from '@/lib/navigation';
import { withBase } from '@/lib/site';
import { strategyTopics } from '@/lib/strategy-topics';

const chapterColors: Record<string, string> = {
  cyan: '#0c7183',
  blue: '#2864b4',
  indigo: '#5158a6',
  violet: '#7651a6',
  magenta: '#9b477c',
  orange: '#b65d20',
  amber: '#9b6a00',
  green: '#38754a',
  teal: '#27766e',
  red: '#a5433d'
};

const chapterByNumber = new Map(curriculum.chapters.map((chapter) => [chapter.chapter, chapter]));

// 三條主線對應側欄的三個分組，讓首頁、側欄與 header 講同一套結構。
const tracks = [
  {
    eyebrow: '讀',
    title: '教材章節',
    href: withBase('/volumes/upper/'),
    cta: '從上冊開始',
    description: '依《演算法競賽》上下冊十章與附錄 A 編排，每一節都有核心導讀，重點主題另有深度教學與視覺化。',
    links: [
      { label: learnLink.label, href: learnLink.href, description: learnLink.description },
      { label: '上冊：第 1–5 章', href: withBase('/volumes/upper/') },
      { label: '下冊：第 6–10 章與附錄 A', href: withBase('/volumes/lower/') }
    ]
  },
  {
    eyebrow: '查',
    title: '策略圖鑑',
    href: withBase('/strategies/'),
    cta: '開啟策略圖鑑',
    description: '同一類解題手法擺在一起，附判斷訊號、正確性論證、常見陷阱與練習路線圖，適合賽前複習與遇到新題時查。',
    links: [
      { label: patternsLink.label, href: patternsLink.href, description: patternsLink.description },
      { label: glossaryLink.label, href: glossaryLink.href, description: glossaryLink.description }
    ]
  },
  {
    eyebrow: '練',
    title: '題庫與題單',
    href: practiceLink.href,
    cta: '前往題庫',
    description: '題庫提供逐層提示、C++17 解答與私人筆記；題單索引則把教材與策略兩份外部題單整理成可篩選的表格。',
    links: [
      { label: '教材題單', href: withBase('/problem-lists/textbook/'), description: '依章節小節編排的配套題單' },
      { label: '策略題單', href: withBase('/problem-lists/strategies/'), description: '依主題、難度與標籤篩選' }
    ]
  }
];
---

<BaseLayout title="總覽" wide>
  <section class="hero">
    <p class="eyebrow">繁體中文學習筆記</p>
    <h1>《演算法競賽》上下冊學習筆記</h1>
    <p class="lede">
      依原書十章編排，每一節整理重點觀念、C++17 範例程式與對應練習題。閱讀前建議先熟悉 C++ 基本語法與陣列、迴圈。
    </p>
    <div class="hero-actions">
      <a class="button" href={withBase('/lessons/binary-search/')}>從二分搜尋開始讀</a>
      <a class="button secondary" href={learnLink.href}>查看學習路線</a>
      <a class="button secondary" href={withBase('/strategies/')}>依解題策略查手法</a>
    </div>
  </section>

  <section aria-labelledby="tracks-title">
    <p class="eyebrow">How to use</p>
    <h2 id="tracks-title">三種用法：讀、查、練</h2>
    <p class="lede">同一批知識有三種索引方式，練習進度共用同一份資料，在任一處標記都會同步。</p>
    <div class="grid">
      {
        tracks.map((track) => (
          <article class="card track-card">
            <p class="eyebrow">{track.eyebrow}</p>
            <h3>
              <a href={track.href}>{track.title}</a>
            </h3>
            <p>{track.description}</p>
            <ul class="track-links">
              {track.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                  {link.description && <span class="meta">{link.description}</span>}
                </li>
              ))}
            </ul>
            <a href={track.href}>{track.cta} →</a>
          </article>
        ))
      }
    </div>
  </section>

  <section style="margin-top:3rem" aria-labelledby="course-map-title">
    <p class="eyebrow">Course map</p>
    <h2 id="course-map-title">上下冊十章地圖</h2>
    {
      textbookNav.map((volume) => (
        <>
          <h3 class="volume-heading">
            <a href={volume.href}>{curriculum.volumes[volume.volume].display_name}</a>
            <span class="meta">
              第 {volume.chapters[0]?.chapter}–{volume.chapters[volume.chapters.length - 1]?.chapter} 章
            </span>
          </h3>
          <div class="grid">
            {volume.chapters.map((entry) => {
              const chapter = chapterByNumber.get(entry.chapter)!;
              return (
                <article class="card chapter-card" style={`--chapter-color:${chapterColors[chapter.color]}`}>
                  <p class="eyebrow">第 {chapter.chapter} 章</p>
                  <h4>
                    <a href={entry.href}>{chapter.title}</a>
                  </h4>
                  <p>
                    {chapter.sections
                      .map((section) => section.title)
                      .slice(0, 4)
                      .join('、')}
                    …
                  </p>
                  <p class="meta">
                    <span>{chapter.sections.length} 節</span>
                    <span>
                      書本 {chapter.book_pages[0]}–{chapter.book_pages[1]} 頁
                    </span>
                  </p>
                </article>
              );
            })}
            {volume.appendix && (
              <article class="card chapter-card" style="--chapter-color:#5f6f7d">
                <p class="eyebrow">Appendix A</p>
                <h4>
                  <a href={volume.appendix.href}>C++ 競賽工程技巧</a>
                </h4>
                <p>{volume.appendix.description}</p>
                <p class="meta">
                  <span>3 節</span>
                  <span>
                    書本 {curriculum.appendix.book_pages[0]}–{curriculum.appendix.book_pages[1]} 頁
                  </span>
                </p>
              </article>
            )}
          </div>
        </>
      ))
    }
  </section>

  <section style="margin-top:3rem" aria-labelledby="strategy-atlas-title">
    <p class="eyebrow">Strategy atlas</p>
    <h2 id="strategy-atlas-title">換一個切面：策略圖鑑</h2>
    <p class="lede">
      章節地圖跟著書本推進；<a href={withBase('/strategies/')}>策略圖鑑</a
      >則把同一類解題手法擺在一起，適合賽前複習與遇到新題時查手法。
    </p>
    <div class="strategy-topic-grid">
      {
        strategyTopics.map((topic) => (
          <a class="strategy-topic-card" href={withBase(`/strategies/${topic.id}/`)}>
            <span class="strategy-topic-icon" aria-hidden="true">
              {topic.icon}
            </span>
            <h3>{topic.name}</h3>
            <p>{topic.tagline}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section style="margin-top:3rem" aria-labelledby="recommended-title">
    <p class="eyebrow">Recommended start</p>
    <h2 id="recommended-title">推薦起點</h2>
    <div class="grid">
      <article class="card">
        <h3>1. 建立判定與不變量</h3>
        <p>從二分搜尋練習半開區間與真假分界。</p>
        <a href={withBase('/lessons/binary-search/')}>開始二分搜尋 →</a>
      </article>
      <article class="card">
        <h3>2. 把問題畫成狀態圖</h3>
        <p>用 BFS／DFS 分清 frontier、visited 與搜尋順序。</p>
        <a href={withBase('/lessons/bfs-dfs/')}>開始圖搜尋 →</a>
      </article>
      <article class="card">
        <h3>3. 完成一次完整練習</h3>
        <p>閱讀題目、逐層提示、解答與本機進度，登入後再同步。</p>
        <a href={withBase('/practice/first-not-less/')}>前往練習 →</a>
      </article>
    </div>
  </section>

  <section class="card" style="margin-top:3rem" aria-labelledby="progress-title">
    <p class="eyebrow">Your progress</p>
    <h2 id="progress-title">目前進度</h2>
    <p id="home-progress">尚未開始。完成 lesson 後，進度會先保存在此裝置。</p>
    <p>
      <a href={withBase('/dashboard/')}>開啟學習儀表板</a>
      <span class="meta">或到<a href={problemListsLink.href}>題單索引</a>挑下一題。</span>
    </p>
  </section>

  <script>
    const completed = Object.keys(localStorage).filter(
      (key) => key.startsWith('ac-progress:') && localStorage.getItem(key) === 'completed'
    ).length;
    const progress = document.querySelector('#home-progress');
    if (progress && completed > 0) progress.textContent = `已完成 ${completed} 篇核心教學；可登入同步到其他裝置。`;
  </script>
</BaseLayout>
