---
import { getCollection, render } from 'astro:content';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import SectionGuide from '@/components/lessons/SectionGuide.astro';
import SectionExamples from '@/components/lessons/SectionExamples.astro';
import ChapterProblemList from '@/components/problems/ChapterProblemList.astro';
import AlgorithmVisualizer from '@/components/visualizers/AlgorithmVisualizer';
import ProgressActions from '@/components/progress/ProgressActions';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { curriculum, sectionSlug } from '@/lib/curriculum';
import { exampleEntriesForSection, problemEntriesForSection, problemKey } from '@/lib/problem-list';
import { withBase } from '@/lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return curriculum.chapters.flatMap((chapter) =>
    chapter.sections.map((section) => {
      // 一個小節可能有多篇深度教學。以小節的正規 slug 選出主課程（例如 4.3 對應
      // segment-tree），其餘列成連結，由 /lessons/topic/[id] 各自成頁；這樣既不會有
      // 連不到的內容，新增教學也不會因為檔名排序而擠掉原本的主課程。
      const slug = sectionSlug(section);
      const sectionLessons = entries.filter((item) => item.data.section === section.id);
      const lesson = sectionLessons.find((item) => item.data.id === slug) ?? sectionLessons[0];
      const siblings = sectionLessons.filter((item) => item.data.id !== lesson?.data.id);
      return {
        params: { slug },
        props: { chapter, section, lesson, siblings }
      };
    })
  );
}

const { chapter, section, lesson, siblings } = Astro.props;
const rendered = lesson ? await render(lesson) : null;
const Content = rendered?.Content;
const allSections = curriculum.chapters.flatMap((item) =>
  item.sections.map((entry) => ({ chapter: item, section: entry }))
);
const currentIndex = allSections.findIndex((item) => item.section.id === section.id);
const previous = allSections[currentIndex - 1];
const next = allSections[currentIndex + 1];
const problemEntries = problemEntriesForSection(section.id);
// 例題一律由題單決定歸屬並在本頁逐題講解；題單清單只保留索引，不再重複同一份題解。
const taughtProblemKeys = exampleEntriesForSection(section.id).map((entry) =>
  problemKey(entry.platform_label, entry.problem_id)
);
---

<BaseLayout title={lesson?.data.title ?? `${section.id} ${section.title}`}>
  <Breadcrumb
    items={[
      { label: chapter.volume === 'upper' ? '上冊' : '下冊', href: withBase(`/volumes/${chapter.volume}/`) },
      { label: `第 ${chapter.chapter} 章 ${chapter.title}`, href: withBase(`/chapters/${chapter.chapter}/`) }
    ]}
    current={`${section.id} ${section.title}`}
  />
  <p class="eyebrow">Lesson {section.id}</p>
  <h1>{lesson?.data.title ?? section.title}</h1>
  <p class="lede">{lesson?.data.summary ?? `本節涵蓋：${section.topics.join('、')}。`}</p>
  <div class="meta">
    <span>{chapter.volume === 'upper' ? '上冊' : '下冊'}</span>
    <span>書頁 {lesson?.data.source_book_pages.join('–') ?? chapter.book_pages.join('–')}</span>
    <span>PDF 頁 {lesson?.data.source_pdf_pages.join('–') ?? chapter.pdf_pages.join('–')}</span>
    <span class="badge verified">{lesson ? '深度教學' : '核心導讀'}</span>
  </div>
  <ProgressActions client:load lessonId={lesson?.data.id ?? `section-${section.id}`} />
  {
    lesson && Content ? (
      <>
        {lesson.data.visualizer && <AlgorithmVisualizer client:visible kind={lesson.data.visualizer} />}
        <Content />
      </>
    ) : (
      <>
        <SectionGuide chapter={chapter} section={section} />
      </>
    )
  }
  {
    siblings.length > 0 && (
      <section class="card">
        <h2>本節其他深度主題</h2>
        <p>這一節還有以下獨立教學，各自有完整模板、複雜度分析與可編譯的 C++17 解答。</p>
        <ul>
          {siblings.map((item) => (
            <li>
              <a href={withBase(`/lessons/topic/${item.data.id}/`)}>{item.data.title}</a>
              <span class="meta"> — {item.data.summary}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <SectionExamples section={section.id} sectionTitle={section.title} />
  {
    problemEntries.length > 0 && (
      <ChapterProblemList
        entries={problemEntries}
        heading="本節《演算法競賽》對應題目"
        taughtProblemKeys={taughtProblemKeys}
      />
    )
  }
  <nav class="page-actions" aria-label="前後教學">
    {
      previous && (
        <a class="button secondary" href={withBase(`/lessons/${sectionSlug(previous.section)}/`)}>
          ← {previous.section.id} {previous.section.title}
        </a>
      )
    }
    {
      next && (
        <a class="button secondary" href={withBase(`/lessons/${sectionSlug(next.section)}/`)}>
          {next.section.id} {next.section.title} →
        </a>
      )
    }
  </nav>
</BaseLayout>
