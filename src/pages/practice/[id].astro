---
import { Code } from 'astro:components';
import { getCollection, render } from 'astro:content';
import ExerciseNotes from '@/components/progress/ExerciseNotes';
import ExerciseStatusControl from '@/components/progress/ExerciseStatusControl';
import Breadcrumb from '@/components/nav/Breadcrumb.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hintStageLabels, threeStageHints } from '@/lib/exercise-content';
import { practiceLink } from '@/lib/navigation';
import { withBase } from '@/lib/site';

export async function getStaticPaths() {
  const exercises = await getCollection('exercises', ({ data }) => data.review_status === 'verified');
  return exercises.map((exercise) => ({ params: { id: exercise.data.id }, props: { exercise } }));
}

const { exercise } = Astro.props;
const { Content } = await render(exercise);
const hints = threeStageHints(exercise.data.hints);
---

<BaseLayout title={exercise.data.title} wide activeChapter={exercise.data.chapter}>
  <Breadcrumb
    items={[
      { label: practiceLink.label, href: practiceLink.href },
      { label: `第 ${exercise.data.chapter} 章`, href: withBase(`/chapters/${exercise.data.chapter}/`) }
    ]}
    current={exercise.data.title}
  />
  <p class="eyebrow">第 {exercise.data.chapter} 章 · 難度 {exercise.data.difficulty}</p>
  <h1>{exercise.data.title}</h1>
  {
    exercise.data.external_url && (
      <p>
        <a class="button secondary" href={exercise.data.external_url} target="_blank" rel="noopener noreferrer">
          {exercise.data.external_relation === 'original' ? '前往原題' : '前往相關原題'}：
          {exercise.data.external_platform} {exercise.data.external_problem_id} ↗
        </a>
      </p>
    )
  }
  <section class="card exercise-progress-card">
    <h2>記錄學習進度</h2>
    <p>這是自我管理狀態，不是線上判題結果。可以隨時改成「待複習」再回來練習。</p>
    <div class="exercise-card-actions">
      <ExerciseStatusControl client:load exerciseId={exercise.data.id} />
      <ExerciseNotes client:load exerciseId={exercise.data.id} title={exercise.data.title} />
    </div>
  </section>
  <article>
    {
      exercise.data.statement_verification === 'pending-author-check' && (
        <p class="content-pending">
          題面待核實：本題的題目敘述與輸入輸出格式是依可取得的資料重建的，尚未與原題頁逐字核對。以下解法、正確性與複雜度針對這份題意成立；提交前請以原題頁為準，並先讀本頁最後的「待核實項目」。
        </p>
      )
    }
    <section>
      <h2>核心知識點與判斷方法</h2>
      <p>
        <strong>核心知識：</strong>
        {(exercise.data.core_knowledge ?? exercise.data.topics).join('、')}
      </p>
      <p>
        {exercise.data.judgment ?? '判斷方法尚待逐題複核；請依資料範圍、目標操作與本節不變量選擇合適方法。'}
      </p>
    </section>
    <h2>題目</h2>
    <p>{exercise.data.statement}</p>
    {
      exercise.data.constraints && (
        <>
          <>
            <h3>限制</h3>
            <ul>
              {exercise.data.constraints.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        </>
      )
    }
    {
      exercise.data.input_format && (
        <>
          <>
            <h3>輸入格式</h3>
            <p>{exercise.data.input_format}</p>
          </>
        </>
      )
    }
    {
      exercise.data.output_format && (
        <>
          <>
            <h3>輸出格式</h3>
            <p>{exercise.data.output_format}</p>
          </>
        </>
      )
    }
    <h3>範例</h3>
    {exercise.data.walkthrough && <p>{exercise.data.walkthrough}</p>}
    {
      exercise.data.samples.map((sample) => (
        <div class="grid">
          <div>
            <strong>輸入</strong>
            <pre set:text={sample.input.trim()} />
          </div>
          <div>
            <strong>輸出</strong>
            <pre set:text={sample.output.trim()} />
          </div>
          {sample.explanation && <p>{sample.explanation}</p>}
        </div>
      ))
    }
    <h2>逐層提示</h2>
    {
      hints.map((hint, index) => (
        <details>
          <>
            <summary>
              提示 {index + 1}：{hintStageLabels[index]}
            </summary>
            {hint.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </>
        </details>
      ))
    }
    {
      exercise.data.cpp_skeleton && (
        <details>
          <summary>可直接提交的 C++17 skeleton</summary>
          <div>
            <p>骨架已處理輸入輸出與資料結構宣告，核心邏輯留給你補上；可直接編譯，先跑通流程再想演算法。</p>
            <Code code={exercise.data.cpp_skeleton} lang="cpp" theme="github-dark-default" />
          </div>
        </details>
      )
    }
    <details>
      <summary>解答與證明（預設收合）</summary>
      <h3>解法概要</h3><p>{exercise.data.solution_outline}</p>
      {
        exercise.data.proof_or_invariant && (
          <>
            <>
              <h3>不變量／正確性</h3>
              <p>{exercise.data.proof_or_invariant}</p>
            </>
          </>
        )
      }
      <h3>複雜度</h3><p>
        時間 {exercise.data.complexity.time}；空間 {exercise.data.complexity.space}。
      </p>
      {
        exercise.data.cpp_solution && (
          <>
            <>
              <h3>參考 C++17</h3>
              <Code code={exercise.data.cpp_solution} lang="cpp" theme="github-dark-default" />
            </>
          </>
        )
      }
    </details>
    <details>
      <summary>常見錯誤</summary>
      {
        exercise.data.common_errors?.length ? (
          <ul>
            {exercise.data.common_errors.map((error) => (
              <li>{error}</li>
            ))}
          </ul>
        ) : (
          <p class="content-pending">本題常見錯誤尚待依原題與解答逐項複核。</p>
        )
      }
    </details>
    <Content />
    <p class="meta">
      來源書頁 {exercise.data.source_book_pages.join('、')}；PDF 頁 {exercise.data.source_pdf_pages.join('、')}。
    </p>
  </article>
</BaseLayout>
