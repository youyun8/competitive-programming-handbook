---
import { strategyBeginnerMeta } from '@/lib/strategy-beginner';
import type { StrategyPage, StrategyTopic } from '@/lib/strategies';

interface Props {
  topic: StrategyTopic;
  page: StrategyPage;
}

const { topic, page } = Astro.props;
const meta = strategyBeginnerMeta[topic.id];
const description = page.desc ?? topic.homeDescription;
---

{
  meta && (
    <section class="beginner-recap" aria-label="本頁複習與除錯">
      <h3>常見誤解與除錯順序</h3>
      <ol class="bug-list">
        {meta.errors.map((item) => (
          <li set:html={item} />
        ))}
      </ol>
      <p>
        <b>最小測資順序：</b>
        先測空集合或最短輸入，再測單一元素、全部相同、嚴格遞增／遞減、重複值與最大邊界；若答案可能累加，另外檢查 32-bit
        overflow。
      </p>
      <h3>複雜度與適用時機</h3>
      <p>
        不要只記正文最後的 Big-O。請把它拆成「狀態／節點／候選數量 ×
        每次轉移或操作成本」，再代入題目的最大資料範圍。若乘積超過時間預算，就回頭找是否重算、能否排序、離線、壓縮狀態或使用更合適的資料結構。
      </p>
      <h3>參考資料</h3>
      <ul class="reference-list">
        {meta.refs.map(([url, label, note]) => (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer">
              {label}
            </a>
            ——{note}
          </li>
        ))}
      </ul>
      <div class="callout idea">
        <b>你現在應該記得什麼</b>
        <ul>
          <li>本頁主題：{description}。</li>
          <li>看到的題型訊號：{meta.signals}</li>
          <li>最重要的不變量：{meta.invariant}</li>
          <li>複雜度要從處理的資料量與每次操作成本相乘推回來。</li>
          <li>先用最小反例驗證直覺，再套模板；模板不是正確性證明。</li>
        </ul>
      </div>
    </section>
  )
}
