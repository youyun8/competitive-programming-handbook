---
import { getCollection } from 'astro:content';
import ExerciseStatusControl from '@/components/progress/ExerciseStatusControl';
import ProblemLearningBody from '@/components/problems/ProblemLearningBody.astro';
import { hasCompleteLearningContent } from '@/lib/exercise-content';
import { problemAnchorId, problemKey, type ProblemEntry } from '@/lib/problem-list';
import { withBase } from '@/lib/site';

interface Props {
  entries: ProblemEntry[];
  heading?: string;
  // 小節頁已在「本節例題精講」逐題講完這些題目，這裡只留索引與錨點，不重複整份題解。
  taughtProblemKeys?: string[];
}

const { entries, heading = '《演算法競賽》對應題目', taughtProblemKeys = [] } = Astro.props;
const taught = new Set(taughtProblemKeys);
const exercises = await getCollection('exercises', ({ data }) => data.review_status === 'verified');
const exerciseByProblem = new Map<string, (typeof exercises)[number]>();
for (const exercise of exercises) {
  if (!exercise.data.external_platform || !exercise.data.external_problem_id) continue;
  const key = problemKey(exercise.data.external_platform, exercise.data.external_problem_id);
  const existing = exerciseByProblem.get(key);
  if (!existing || (existing.data.external_relation !== 'original' && exercise.data.external_relation === 'original')) {
    exerciseByProblem.set(key, exercise);
  }
}
const sections = new Map<string, ProblemEntry[]>();
for (const entry of entries) {
  const sectionEntries = sections.get(entry.section) ?? [];
  sectionEntries.push(entry);
  sections.set(entry.section, sectionEntries);
}
---

<section class="chapter-problems" aria-labelledby="chapter-problems-title">
  <h2 id="chapter-problems-title">{heading}</h2>
  <p class="lede">
    題名與分類依外部題單，章節名稱一律採本站教材用語。展開題目可查看已審核的教學內容；尚未完成獨立核實的部分會明確標示，不以通用模板冒充題解。
  </p>
  {
    [...sections.entries()].map(([sectionId, sectionEntries]) => (
      <details class="problem-section-disclosure">
        <summary>
          {sectionId} {sectionEntries[0]?.section_title}
          <span class="meta">（{sectionEntries.length} 筆）</span>
        </summary>
        <div class="problem-card-list">
          {sectionEntries.map((entry) => {
            const key = problemKey(entry.platform_label, entry.problem_id);
            const exercise = exerciseByProblem.get(key);
            const complete = exercise ? hasCompleteLearningContent(exercise.data) : false;
            const statusId = exercise?.data.id ?? `problem-${key.replace(':', '-')}`;
            const anchor = problemAnchorId(entry.platform_label, entry.problem_id);
            const taughtOnPage = taught.has(key);
            const sourceSubdivision =
              entry.source_section !== entry.section
                ? `${entry.source_section} ${entry.source_section_title}`
                : undefined;
            return (
              <details class="problem-learning-card" data-content-status={complete ? 'complete' : 'roadmap'}>
                <summary>
                  <span>
                    <span class:list={['badge', entry.group]}>{entry.group === 'example' ? '例題' : '習題'}</span>{' '}
                    {entry.platform_label} {entry.problem_id} · {entry.title}
                  </span>
                  <span class:list={['badge', complete ? 'verified' : 'needs-review']}>
                    {taughtOnPage ? '本頁已講解' : complete ? '完整教學' : '待內容複核'}
                  </span>
                </summary>
                <div class="problem-learning-content">
                  {sourceSubdivision && <p class="meta">原題單細分類：{sourceSubdivision}</p>}
                  <div class="problem-links">
                    <a href={entry.url} target="_blank" rel="noopener noreferrer nofollow">
                      前往外部題目 ↗
                    </a>
                    {exercise && <a href={withBase(`/practice/${exercise.data.id}/`)}>開啟獨立題目頁與解題筆記</a>}
                    {taughtOnPage ? (
                      <a href={`#${anchor}`}>跳到本節例題精講</a>
                    ) : (
                      entry.lesson_href && <a href={withBase(entry.lesson_href)}>回到本節教學</a>
                    )}
                  </div>
                  <ExerciseStatusControl client:visible exerciseId={statusId} compact />
                  {taughtOnPage ? (
                    <p>
                      本題是本節例題，題面、判斷方法、推演、正確性、複雜度與 C++17
                      解答已在上方「本節例題精講」完整講解。
                    </p>
                  ) : (
                    <ProblemLearningBody exercise={exercise} />
                  )}
                </div>
              </details>
            );
          })}
        </div>
      </details>
    ))
  }
</section>
